=\".6\"/>\n              <circle cx=\"371\" cy=\"145\" r=\"3\" fill=\"currentColor\" stroke=\"none\"/>\n            </svg><span></span>\n            </div>\n            <div class=\"phone-preview\"></div>\n          </div>\n          <div class=\"panel-copy\">\n            <p class=\"section-kicker\" data-campaign-kicker>01 / Objective</p>\n            <h3 data-campaign-title>Choose the outcome that matters first.</h3>\n            <p data-campaign-copy>Awareness, traffic, or conversion goals shape the audience, creative, budget, and measurement path.</p>\n            <a class=\"button button-primary\" href=\"#contact\">Get started</a>\n            <a class=\"button button-secondary\" href=\"#formats\">View formats</a>\n          </div>\n        </div>\n      </section>",
