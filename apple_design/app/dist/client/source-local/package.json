{
  "name": "apple-design-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node scripts/build.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "sources:refresh": "cd .. && node scripts/complete-sources.mjs --refresh",
    "tokens:build": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "build:library": "node scripts/build-library.mjs",
    "capture:motions": "cd .. && node scripts/capture-runtime-motion.mjs",
    "motions:catalog": "cd .. && node scripts/build-motion-catalog.mjs",
    "motions:verify": "cd .. && node scripts/verify-runtime-motion.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {}
}
