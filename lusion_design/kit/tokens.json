{
  "name": "lusion-inspired-portable-design-system",
  "version": "1.1.0",
  "source": {
    "basis": "Public visual grammar summarized from repository DESIGN.md and extracted Lusion tokens.",
    "standalone": true,
    "dependencies": [],
    "cssSource": "./tokens.css",
    "comparison": "The cssVariables object mirrors custom properties declared in tokens.css so scripts can compare --ds-* values directly."
  },
  "cssVariables": {
    "--ds-font-sans": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans KR\", \"Apple SD Gothic Neo\", Arial, sans-serif",
    "--ds-font-mono": "ui-monospace, \"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace",
    "--ds-color-bg": "#f0f1fa",
    "--ds-color-surface": "#ffffff",
    "--ds-color-surface-raised": "#f7f8fc",
    "--ds-color-text": "#050608",
    "--ds-color-muted": "#5f6675",
    "--ds-color-primary": "#1a2ffb",
    "--ds-color-on-primary": "#ffffff",
    "--ds-color-border": "#cfd4df",
    "--ds-color-focus": "#1a2ffb",
    "--ds-color-danger": "#d92d20",
    "--ds-color-on-danger": "#ffffff",
    "--ds-color-success": "#16794c",
    "--ds-color-warning": "#9a6700",
    "--ds-shadow-sm": "0 1px 0 rgba(7, 10, 20, .06), 0 14px 30px rgba(22, 30, 60, .08)",
    "--ds-shadow-md": "0 24px 70px rgba(12, 18, 40, .14)",
    "--ds-space-1": "4px",
    "--ds-space-2": "8px",
    "--ds-space-3": "12px",
    "--ds-space-4": "16px",
    "--ds-space-5": "20px",
    "--ds-space-6": "24px",
    "--ds-space-7": "32px",
    "--ds-space-8": "40px",
    "--ds-space-9": "56px",
    "--ds-radius-1": "4px",
    "--ds-radius-2": "8px",
    "--ds-radius-3": "12px",
    "--ds-radius-pill": "999px",
    "--ds-type-xs": ".75rem",
    "--ds-type-sm": ".875rem",
    "--ds-type-md": "1rem",
    "--ds-type-lg": "1.125rem",
    "--ds-type-xl": "1.5rem",
    "--ds-type-2xl": "2rem",
    "--ds-type-display": "clamp(2.625rem, 6vw, 6.75rem)",
    "--ds-line-tight": "1.05",
    "--ds-line-ui": "1.25",
    "--ds-line-copy": "1.65",
    "--ds-weight-regular": "400",
    "--ds-weight-medium": "560",
    "--ds-weight-strong": "700",
    "--ds-motion-instant": "100ms",
    "--ds-motion-fast": "200ms",
    "--ds-motion-base": "300ms",
    "--ds-motion-slow": "400ms",
    "--ds-motion-panel": "500ms",
    "--ds-motion-line": "600ms",
    "--ds-motion-loop": "3000ms",
    "--ds-stagger": "20ms",
    "--ds-stagger-word": "40ms",
    "--ds-ease": "cubic-bezier(.4, 0, .1, 1)",
    "--ds-ease-standard": "cubic-bezier(.4, 0, .1, 1)",
    "--ds-ease-smooth": "cubic-bezier(.35, 0, 0, 1)",
    "--ds-ease-enter": "cubic-bezier(.4, 0, 0, 1)",
    "--ds-ease-out": "cubic-bezier(.16, 1, .3, 1)",
    "--ds-ease-loop": "cubic-bezier(.1, 0, .1, 1)",
    "--ds-ease-expo": "cubic-bezier(.19, 1, .22, 1)",
    "--ds-rise": "1.5em",
    "--ds-rise-tilt": "15deg",
    "--ds-panel-rise": "5.5em",
    "--ds-panel-tilt": "3.5deg",
    "--ds-burst": "20",
    "--ds-swap-distance": "3em",
    "--ds-cross-size": "clamp(.875rem, 1vw, 2rem)",
    "--ds-cursor-size": "6.25em",
    "--ds-touch": "44px",
    "--ds-container": "1180px",
    "--ds-gutter": "clamp(16px, 5vw, 72px)",
    "--ds-grid-gap": "clamp(12px, 2vw, 28px)"
  },
  "themes": {
    "light": {
      "colorScheme": "light",
      "semantic": {
        "bg": "--ds-color-bg",
        "surface": "--ds-color-surface",
        "text": "--ds-color-text",
        "muted": "--ds-color-muted",
        "primary": "--ds-color-primary",
        "onPrimary": "--ds-color-on-primary",
        "border": "--ds-color-border",
        "focus": "--ds-color-focus",
        "danger": "--ds-color-danger",
        "success": "--ds-color-success"
      }
    },
    "dark": {
      "colorScheme": "dark",
      "cssVariables": {
        "--ds-color-bg": "#11141d",
        "--ds-color-surface": "#191d29",
        "--ds-color-surface-raised": "#232838",
        "--ds-color-text": "#f7f8ff",
        "--ds-color-muted": "#aeb6c8",
        "--ds-color-primary": "#7c8cff",
        "--ds-color-on-primary": "#08104f",
        "--ds-color-border": "#363d50",
        "--ds-color-focus": "#91a0ff",
        "--ds-color-danger": "#ff6b61",
        "--ds-color-on-danger": "#1b0706",
        "--ds-color-success": "#5ee0a0",
        "--ds-color-warning": "#ffd166",
        "--ds-shadow-sm": "0 1px 0 rgba(255, 255, 255, .06), 0 14px 30px rgba(0, 0, 0, .2)",
        "--ds-shadow-md": "0 24px 70px rgba(0, 0, 0, .34)"
      }
    },
    "system": {
      "colorScheme": "light dark",
      "usesMediaQuery": "(prefers-color-scheme: dark)"
    }
  },
  "colors": {
    "bg": {
      "value": "#f0f1fa",
      "cssVariable": "--ds-color-bg"
    },
    "surface": {
      "value": "#ffffff",
      "cssVariable": "--ds-color-surface"
    },
    "text": {
      "value": "#050608",
      "cssVariable": "--ds-color-text"
    },
    "muted": {
      "value": "#5f6675",
      "cssVariable": "--ds-color-muted"
    },
    "primary": {
      "value": "#1a2ffb",
      "cssVariable": "--ds-color-primary"
    },
    "onPrimary": {
      "value": "#ffffff",
      "cssVariable": "--ds-color-on-primary"
    },
    "border": {
      "value": "#cfd4df",
      "cssVariable": "--ds-color-border"
    },
    "focus": {
      "value": "#1a2ffb",
      "cssVariable": "--ds-color-focus"
    },
    "danger": {
      "value": "#d92d20",
      "cssVariable": "--ds-color-danger"
    },
    "onDanger": {
      "value": "#ffffff",
      "cssVariable": "--ds-color-on-danger"
    },
    "success": {
      "value": "#16794c",
      "cssVariable": "--ds-color-success"
    }
  },
  "spacing": {
    "1": {
      "value": "4px",
      "cssVariable": "--ds-space-1"
    },
    "2": {
      "value": "8px",
      "cssVariable": "--ds-space-2"
    },
    "3": {
      "value": "12px",
      "cssVariable": "--ds-space-3"
    },
    "4": {
      "value": "16px",
      "cssVariable": "--ds-space-4"
    },
    "5": {
      "value": "20px",
      "cssVariable": "--ds-space-5"
    },
    "6": {
      "value": "24px",
      "cssVariable": "--ds-space-6"
    },
    "7": {
      "value": "32px",
      "cssVariable": "--ds-space-7"
    },
    "8": {
      "value": "40px",
      "cssVariable": "--ds-space-8"
    },
    "9": {
      "value": "56px",
      "cssVariable": "--ds-space-9"
    }
  },
  "radius": {
    "1": {
      "value": "4px",
      "cssVariable": "--ds-radius-1"
    },
    "2": {
      "value": "8px",
      "cssVariable": "--ds-radius-2"
    },
    "3": {
      "value": "12px",
      "cssVariable": "--ds-radius-3"
    },
    "pill": {
      "value": "999px",
      "cssVariable": "--ds-radius-pill"
    }
  },
  "typography": {
    "scale": {
      "xs": {
        "value": ".75rem",
        "cssVariable": "--ds-type-xs"
      },
      "sm": {
        "value": ".875rem",
        "cssVariable": "--ds-type-sm"
      },
      "md": {
        "value": "1rem",
        "cssVariable": "--ds-type-md"
      },
      "lg": {
        "value": "1.125rem",
        "cssVariable": "--ds-type-lg"
      },
      "xl": {
        "value": "1.5rem",
        "cssVariable": "--ds-type-xl"
      },
      "2xl": {
        "value": "2rem",
        "cssVariable": "--ds-type-2xl"
      },
      "display": {
        "value": "clamp(2.625rem, 6vw, 6.75rem)",
        "cssVariable": "--ds-type-display"
      }
    },
    "lineHeight": {
      "tight": {
        "value": "1.05",
        "cssVariable": "--ds-line-tight"
      },
      "ui": {
        "value": "1.25",
        "cssVariable": "--ds-line-ui"
      },
      "copy": {
        "value": "1.65",
        "cssVariable": "--ds-line-copy"
      }
    }
  },
  "motion": {
    "basis": "research/interaction-evidence.md. extracted = public CSS/JS value, recommended = kit decision.",
    "duration": {
      "instant": {
        "value": "100ms",
        "cssVariable": "--ds-motion-instant",
        "grade": "extracted",
        "use": "talk-button dot shrink"
      },
      "fast": {
        "value": "200ms",
        "cssVariable": "--ds-motion-fast",
        "grade": "extracted",
        "use": "menu link arrow"
      },
      "base": {
        "value": "300ms",
        "cssVariable": "--ds-motion-base",
        "grade": "extracted",
        "use": "link underline, dot scale, talk-button label"
      },
      "slow": {
        "value": "400ms",
        "cssVariable": "--ds-motion-slow",
        "grade": "extracted",
        "use": "text swap, menu dots rotate, CTA dot/label/arrow, icon swap"
      },
      "panel": {
        "value": "500ms",
        "cssVariable": "--ds-motion-panel",
        "grade": "extracted",
        "use": "menu panel items, CTA background/colour, preloader hide"
      },
      "line": {
        "value": "600ms",
        "cssVariable": "--ds-motion-line",
        "grade": "extracted",
        "use": "footer underline, split-word entrance"
      },
      "loop": {
        "value": "3000ms",
        "cssVariable": "--ds-motion-loop",
        "grade": "extracted",
        "use": "arrow/text loop hints"
      }
    },
    "stagger": {
      "item": {
        "value": "20ms",
        "cssVariable": "--ds-stagger",
        "grade": "extracted",
        "use": "menu panel: open index*20ms, close (n-index)*20ms"
      },
      "word": {
        "value": "40ms",
        "cssVariable": "--ds-stagger-word",
        "grade": "recommended",
        "use": "split text words/chars, reveal groups"
      }
    },
    "ease": {
      "standard": {
        "value": "cubic-bezier(.4, 0, .1, 1)",
        "cssVariable": "--ds-ease-standard",
        "alias": "--ds-ease",
        "grade": "extracted",
        "count": 32
      },
      "smooth": {
        "value": "cubic-bezier(.35, 0, 0, 1)",
        "cssVariable": "--ds-ease-smooth",
        "grade": "extracted",
        "count": 32,
        "js": "ease.lusion"
      },
      "enter": {
        "value": "cubic-bezier(.4, 0, 0, 1)",
        "cssVariable": "--ds-ease-enter",
        "grade": "extracted",
        "count": 2
      },
      "out": {
        "value": "cubic-bezier(.16, 1, .3, 1)",
        "cssVariable": "--ds-ease-out",
        "grade": "extracted",
        "count": 2
      },
      "loop": {
        "value": "cubic-bezier(.1, 0, .1, 1)",
        "cssVariable": "--ds-ease-loop",
        "grade": "extracted",
        "count": 3
      },
      "expo": {
        "value": "cubic-bezier(.19, 1, .22, 1)",
        "cssVariable": "--ds-ease-expo",
        "grade": "recommended",
        "note": "CSS approximation of JS expoOut"
      }
    },
    "displacement": {
      "rise": {
        "value": "1.5em",
        "cssVariable": "--ds-rise",
        "grade": "extracted",
        "use": "word entrance translateY"
      },
      "riseTilt": {
        "value": "15deg",
        "cssVariable": "--ds-rise-tilt",
        "grade": "extracted",
        "use": "word entrance rotate"
      },
      "panelRise": {
        "value": "5.5em",
        "cssVariable": "--ds-panel-rise",
        "grade": "extracted"
      },
      "panelTilt": {
        "value": "3.5deg",
        "cssVariable": "--ds-panel-tilt",
        "grade": "extracted"
      },
      "burst": {
        "value": "20",
        "cssVariable": "--ds-burst",
        "grade": "extracted",
        "note": "home reel CTA; featured 32, detail 26"
      },
      "swapDistance": {
        "value": "3em",
        "cssVariable": "--ds-swap-distance",
        "grade": "extracted"
      },
      "crossSize": {
        "value": "clamp(.875rem, 1vw, 2rem)",
        "cssVariable": "--ds-cross-size",
        "grade": "extracted"
      },
      "cursorSize": {
        "value": "6.25em",
        "cssVariable": "--ds-cursor-size",
        "grade": "extracted"
      }
    },
    "dynamics": {
      "model": "second-order (frequency f, damping z, response r); k1=z/(pi f), k2=1/(2 pi f)^2, k3=r z/(2 pi f)",
      "maxFrameSeconds": 0.05,
      "presets": {
        "pointer": {
          "frequency": 1.5,
          "damping": 0.8,
          "response": 2,
          "grade": "extracted",
          "use": "eased pointer input default"
        },
        "cursor": {
          "frequency": 1,
          "damping": 0.8,
          "response": 1.2,
          "grade": "extracted",
          "use": "cursor extra rotation"
        },
        "focus": {
          "frequency": 1,
          "damping": 0.6,
          "response": 2,
          "grade": "extracted",
          "use": "depth-card focus"
        },
        "zoom": {
          "frequency": 2.2,
          "damping": 0.7,
          "response": 3,
          "grade": "extracted",
          "use": "depth-card zoom"
        },
        "snap": {
          "frequency": 2.5,
          "damping": 0.5,
          "response": 2,
          "grade": "extracted",
          "use": "card border; kit magnetic"
        },
        "drift": {
          "frequency": 1,
          "damping": 0.65,
          "response": 1.3,
          "grade": "extracted",
          "use": "object position; kit tilt"
        },
        "rotate": {
          "frequency": 1,
          "damping": 0.85,
          "response": 1.1,
          "grade": "extracted",
          "use": "object rotation"
        }
      },
      "damp": {
        "formula": "lerp(a,b,1-exp(-lambda*dt))",
        "scrollStrengthLambda": 10,
        "grade": "extracted"
      }
    },
    "runtimeAttributes": {
      "data-ds-reveal": "rise | fade | scale | mask | line; data-ds-reveal-repeat, data-ds-reveal-manual",
      "data-ds-split": "words | chars; wraps text, sets aria-label, restores on destroy",
      "data-ds-stagger": "writes --ds-i/--ds-n on direct children",
      "data-ds-panel": "id + data-ds-panel-toggle/open/close; Escape, inert, focus return",
      "data-ds-magnetic": "strength 0..0.6; data-ds-magnetic-dynamics preset",
      "data-ds-tilt": "degrees 0..30; data-ds-tilt-layer with --ds-depth",
      "data-ds-cursor": "follower element; targets carry data-ds-cursor-label / data-ds-cursor-scale",
      "data-ds-scroll-progress": "optional scroll container selector; writes --ds-progress and data-ds-scroll-state"
    }
  },
  "components": [
    "button",
    "field",
    "input",
    "card",
    "badge",
    "tabs",
    "accordion",
    "dialog",
    "toast",
    "progress",
    "grid",
    "stack"
  ],
  "runtimeApi": {
    "module": "./system.js",
    "mount": "mount(root, { motion: true })",
    "returns": [
      "destroy",
      "notify",
      "openDialog",
      "closeDialog",
      "setTheme"
    ],
    "helpers": [
      "createSpring"
    ]
  }
}
